<?xml version="1.0" encoding="utf-8"?>
<!--
  SyntaxColorizer is the syntax highlighter in the Mermaid dialog. Version 1.1.0 is the first
  with a Mermaid tokenizer in it, and until that version is on nuget.org it is taken from the
  copy in packages/ beside this file.

  The copy is committed so that a clean checkout builds - the release workflow checks out this
  repository and nothing else. When 1.1.0 reaches nuget.org, delete packages/ and this
  <packageSources> entry and the ordinary reference will resolve as usual.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local" value="packages" />
  </packageSources>
</configuration>
