<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Turns USERGUIDE.md into USERGUIDE.pdf. A project of its own, so it is no part of the app
    and invisible to the build that ships it: build.sh publishes AVASvgMaker.csproj by name.

    It renders with Skia rather than shelling out to a browser or a TeX distribution, because
    the guide has to be rebuildable by anyone with the .NET SDK and nothing else - the same
    reason the app writes its own BMPs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AVASvgMaker.Guide</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />
  </ItemGroup>

</Project>
